# Copy to `.env` (next to docker-compose.yml) to change anything below. All of it is optional.

# Port Penny is served on, and its public address (used in links inside e-mails).
PORT=3001
APP_URL=http://localhost:3001

# Postgres password, and the loopback-only port Postgres is published on.
# Set the password BEFORE the first `docker compose up`: Postgres only reads it when it creates the database.
DB_PASSWORD=penny
DB_PORT=5434

# Where the backups are kept on this computer (default: the "backups" folder next to this file). A folder on another drive,
# or one that OneDrive/Dropbox syncs, keeps them safe if this disk fails.
BACKUP_HOST_DIR=./backups

# Development only (".\penny dev"): the address the frontend dev server is opened on.
WEB_PORT=5173

# A public site sits behind a web server or proxy (Caddy, nginx, Cloudflare ...): put how many here (usually 1), so Penny sees the real visitor
# address. Without it every visitor looks like the proxy and they all share one rate limit. Leave empty when nothing is in front of Penny.
TRUST_PROXY=

# open (default) or closed. Closed: nobody new can sign up, but the people who already have an account can sign in. Handy when Penny is online
# for you and your family first.
SIGNUPS=open

# Who runs this site, shown on the terms and privacy pages (people accept them when they sign up). Fill in OPERATOR_NAME before the site is public.
# People write to you through the contact form (Admin, Messages); CONTACT_EMAIL is optional and only adds an address to those pages.
OPERATOR_NAME=
CONTACT_EMAIL=

# Replies to your answers come back into Admin, Messages (see README, "Replies by e-mail"). Leave both empty to switch it off.
# REPLY_DOMAIN is a name whose MX records point at Brevo (for example reply.your-domain.app); INBOUND_SECRET is a long random text (it is part of the address Brevo calls).
REPLY_DOMAIN=
INBOUND_SECRET=

# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Signs unsubscribe links. Leave empty to have one generated and kept in the database.
APP_SECRET=

# Google sign-in (leave empty to hide the button).
GOOGLE_CLIENT_ID=

# E-mail delivery (leave SMTP_HOST empty to save e-mails to a folder instead of sending them).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Penny <alerts@example.com>

# AI answers in the assistant (README, "AI answers"). Leave the key empty to switch it off: the assistant then uses only its built-in answers.
# The key comes from openrouter.ai (Keys). Only FREE models are ever used. People switch it on for themselves (and every member of a shared budget has to).
# On the live site, run  .\penny ai-setup  instead of writing the key here: it asks for it without showing it.
OPENROUTER_API_KEY=
# Optional: up to three free models to try in order, comma separated (each ends in :free, or is openrouter/free). Empty = Penny's own list.
AI_MODELS=
# deny (default): only providers that promise not to keep or train on what they receive. allow: any free provider (they may keep it). Read the README first.
AI_DATA_COLLECTION=deny
# Free models allow only so many questions a day, so Penny counts too: for the whole site, and for each person (0 = no limit).
AI_DAILY_LIMIT=40
AI_PERSON_DAILY_LIMIT=20
