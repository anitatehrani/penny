# Settings for the live server. On the server: copy this to ".env" in the penny folder and fill it in. The real ".env" is never committed.

# Use both compose files with plain `docker compose ...` commands.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Your web address, WITHOUT https://. It must already point at this server (an "A" record in your domain's DNS).
DOMAIN=budget.example.com

# Made up once, before the first start (it is only read when the database is first created):   openssl rand -hex 16
DB_PASSWORD=

# closed: nobody new can sign up (you and the people who already have an account can sign in). To open the site, change this line to
# SIGNUPS=open and run   docker compose up -d
SIGNUPS=closed

# Who runs this site, shown on the terms and privacy pages (people accept them when they sign up). Fill both in before opening sign-ups:
# your name (or the name you run it under) and an address people can write to about their data.
OPERATOR_NAME=
CONTACT_EMAIL=

# Real e-mail (confirmation and alert e-mails). Without SMTP_HOST nobody receives anything. Use the settings your mail service gives you.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Penny <alerts@budget.example.com>

# Optional: Google sign-in (see the README), and a fixed secret for unsubscribe links (empty = one is made up and kept in the database).
GOOGLE_CLIENT_ID=
APP_SECRET=
