# Copy to server/.env
DATABASE_URL=postgres://budget@127.0.0.1:5433/budget
PORT=3001

# Google sign-in (optional): OAuth "Web application" client ID from Google Cloud Console.
# Leave empty to hide the Google button. See README > Google sign-in.
GOOGLE_CLIENT_ID=

# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
